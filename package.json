{
	"name": "@taco-ai/pi-harness",
	"version": "0.1.0",
	"description": "AgentHarness extracted from @earendil-works/pi-agent-core@0.99.2, kept compatible with the latest pi base packages (pi-ai/chord/pi-telemetry 1.x)",
	"author": "NiumAgents <niuma1024@outlook.com>",
	"type": "module",
	"packageManager": "pnpm@11.7.0",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./harness/context": {
			"types": "./dist/harness/context.d.ts",
			"import": "./dist/harness/context.js"
		},
		"./experimental/pico3": {
			"types": "./dist/harness/pico3/index.d.ts",
			"import": "./dist/harness/pico3/index.js"
		},
		"./harness/env/nodejs": {
			"types": "./dist/harness/env/nodejs.d.ts",
			"import": "./dist/harness/env/nodejs.js"
		},
		"./harness/runtime/reducer": {
			"types": "./dist/harness/runtime/reducer.d.ts",
			"import": "./dist/harness/runtime/reducer.js"
		},
		"./harness/session": {
			"types": "./dist/harness/session/index.d.ts",
			"import": "./dist/harness/session/index.js"
		},
		"./harness/session/testing": {
			"types": "./dist/harness/session/testing/index.d.ts",
			"import": "./dist/harness/session/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"docs",
		"LICENSE",
		"LICENSE.upstream",
		"README.md",
		"README.zh-CN.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"docs:telemetry": "node --experimental-strip-types scripts/generate-telemetry-docs.ts",
		"docs:telemetry:check": "node --experimental-strip-types scripts/generate-telemetry-docs.ts --check",
		"test": "vitest --run",
		"test:harness": "vitest --run --config vitest.harness.config.ts",
		"test:session:conformance": "vitest --run --config vitest.harness.config.ts test/harness/memory-conformance.test.ts",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run clean && npm run build && npm test"
	},
	"peerDependencies": {
		"@earendil-works/chord": "^1.3.0",
		"@earendil-works/pi-ai": "^1.3.0",
		"@earendil-works/pi-telemetry": "^1.3.0"
	},
	"dependencies": {
		"diff": "8.0.4",
		"ignore": "7.0.8",
		"typebox": "1.3.27",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@vitest/coverage-v8": "4.1.11",
		"shx": "0.4.0",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"keywords": [
		"ai",
		"agent",
		"harness",
		"llm",
		"agentharness"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "github:niuma996/pi-harness"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
